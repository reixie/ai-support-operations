        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({\n  model: \"qwen2.5:3b\",\n  stream: false,\n  format: \"json\",\n  messages: [\n    {\n      role: \"system\",\n      content: \"Classify the support ticket. Return JSON with category (technical, billing, general), priority (high, medium, low), and summary.\"\n    },\n    {\n      role: \"user\",\ncontent: $('Webhook').first().json.body.message    }\n  ],\n  options: {\n    temperature: 0\n  }\n}) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
