      "id": "3fe84f09-f5ae-4d65-a27c-edb9efe05215",
      "name": "AI Classifier",
      "retryOnFail": true,
      "onError": "continueErrorOutput",
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst ticket = $('Webhook').first().json.body;\n\n// Разрешённые значения\nconst categories = [\"technical\", \"billing\", \"general\"];\nconst priorities = [\"high\", \"medium\", \"low\"];\n\ntry {\n  const result = JSON.parse(response.message.content);\n\n  // Проверяем категорию\n  if (!categories.includes(result.category)) {\n    throw new Error(\"Invalid category\");\n  }\n\n  // Проверяем приоритет\n  if (!priorities.includes(result.priority)) {\n    throw new Error(\"Invalid priority\");\n  }\n\n  // Проверяем описание\n  if (typeof result.summary !== \"string\" ||\n      result.summary.trim() === \"\") {\n    throw new Error(\"Invalid summary\");\n  }\n\n  return [{\n    json: {\n      ticket_id: ticket.ticket_id,\n      message: ticket.message,\n      category: result.category,\n      priority: result.priority,\n      summary: result.summary,\n      status: \"success\"\n    }\n  }];\n\n} catch (error) {\n  return [{\n    json: {\n      ticket_id: ticket.ticket_id,\n      message: ticket.message,\n      category: \"unknown\",\n      priority: \"unknown\",\n      summary: \"AI processing failed: \" + error.message,\n      status: \"manual_review\"\n    }\n  }];\n}"
      },
